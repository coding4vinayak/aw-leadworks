{
  "name": "leadworks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p ${PORT:-3300}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "seed:key": "tsx prisma/seed-key.ts",
    "check:contract": "tsx scripts/check-contract.mts",
    "check:llms-full": "tsx scripts/build-llms-full.mts --check",
    "build:llms-full": "tsx scripts/build-llms-full.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.9.0",
    "axios": "^1.7.7",
    "bullmq": "^6.4.0",
    "cheerio": "^1.0.0",
    "chromium-bidi": "^17.0.2",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "ioredis": "^6.0.0",
    "next": "16.4.2",
    "pdfkit": "^0.20.2",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
