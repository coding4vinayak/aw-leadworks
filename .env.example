# LeadWorks - Lead Sourcing & Enrichment
# SQLite by default so the product runs with zero infrastructure.
# For Postgres: change `provider` in prisma/schema.prisma to "postgresql" and
# point this at your database. Nothing else needs to change.
# Local Postgres via `docker compose up -d` (any Postgres 15+ works).
DATABASE_URL="postgresql://leadworks:leadworks@localhost:5432/leadworks"

# Redis for BullMQ queues
REDIS_URL="redis://localhost:6379"

# Optional: Apollo.io API for enrichment
# APOLLO_API_KEY=

# Optional: Clearbit API for enrichment
# CLEARBIT_API_KEY=

# Optional: Hunter.io API for email verification
# HUNTER_API_KEY=

# Optional: LinkedIn API
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Optional: Playwright browsers will be installed on first run
# PLAYWRIGHT_BROWSERS_PATH=0
PRODUCT_NAME=LeadWorks
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3300

# Email delivery for verification + password reset. Unset, links are written to
# the server log and the UI says so instead of claiming a message was sent.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Abetworks <noreply@yourdomain.com>
